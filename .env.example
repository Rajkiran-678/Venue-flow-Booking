# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/venueflow

# Replace this with a long, random secret before deployment
SESSION_SECRET=replace-this-with-a-long-random-secret

# The admin user is created by `npm run seed`; use an email you control
ADMIN_EMAIL=admin@venueflow.local
ADMIN_PASSWORD=replace-this-with-a-strong-password

NODE_ENV=development
PORT=3000
